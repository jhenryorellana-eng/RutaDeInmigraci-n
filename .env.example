# Las dos claves PÚBLICAS de Supabase. Salen de Project settings → API.
# Van al navegador a propósito: con ellas sólo se puede hacer lo que el RLS
# permite, que es apartar una cita y preguntar qué horas están ocupadas.
NEXT_PUBLIC_SUPABASE_URL=

# La clave pública admite sus DOS nombres, y da igual cuál pongas:
#
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY   la nueva (sb_publishable_…)
#   NEXT_PUBLIC_SUPABASE_ANON_KEY          la de siempre (un JWT, eyJ…)
#
# Supabase ya ofrece la nueva en su panel con ese nombre, así que copiarla
# tal cual es lo que cualquiera haría al desplegar. Se aceptan las dos para
# que eso no acabe en un sitio que arranca, se ve entero, y no conecta con
# nada — un fallo que sólo se descubre cuando alguien intenta reservar.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# La `service_role` NO va aquí ni en ningún sitio de este proyecto: se salta
# el RLS entero, y el RLS es lo único que impide leer el nombre, el correo y
# la nacionalidad de todas las personas que han apartado una cita.

# La llave PÚBLICA de los avisos al teléfono (empieza por B…). Va al
# navegador a propósito: con ella sólo se puede PEDIR una suscripción, nunca
# mandar un aviso. La privada no va aquí — vive en los secretos de la Edge
# Function `avisar-cita`, dentro de Supabase. Ver el README.
NEXT_PUBLIC_VAPID_PUBLICA=

# El dominio público del sitio, con https y sin barra al final:
#   NEXT_PUBLIC_SITE_URL=https://rutadelinmigrante.com
#
# Sólo lo usan las vistas previas de los enlaces (WhatsApp, X): para traerse
# la foto de la tarjeta hace falta una dirección ABSOLUTA, y de aquí sale.
# Si se deja vacío en Vercel, se usa el dominio de producción que Vercel
# publica solo, así que la vista previa funciona igualmente — pero apuntando
# a la dirección `.vercel.app` en vez de al dominio propio.
NEXT_PUBLIC_SITE_URL=
